# FamilySearch Beta (AMBIENTE COMPLETO BETA)
FS_APP_KEY=YOUR_FAMILYSEARCH_BETA_APP_KEY
FS_REDIRECT_URI=https://your-domain.example.com/api/auth/callback
FS_AUTH_BASE_URL=https://identbeta.familysearch.org/cis-web/oauth2/v3
FS_API_BASE_URL=https://apibeta.familysearch.org
FS_OAUTH_SCOPE=https://api.familysearch.org/auth/familytree.read

# App origin (URL pública da aplicação)
NEXT_PUBLIC_APP_ORIGIN=https://your-domain.example.com
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://your-domain.example.com

# Session secret (mínimo 32 caracteres - gere um aleatório)
SESSION_SECRET=please-change-me-to-a-random-32-plus-character-string
TOKEN_ENCRYPTION_KEY=please-change-me-to-another-random-32-plus-character-string

# Database para execução sem docker compose
DATABASE_URL=postgresql://genealogy:change-me@localhost:5432/genealogy?schema=public

# Docker Compose / Dokploy
POSTGRES_DB=genealogy
POSTGRES_USER=genealogy
POSTGRES_PASSWORD=change-me-to-a-strong-database-password
APP_PORT=3000
RUN_MIGRATIONS=true
APP_STORAGE_DIR=/data
